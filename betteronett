-- // HELPER
local function Notify(title, content, duration)
    Rayfield:Notify({
        Title = title,
        Content = content,
        Duration = duration or 4,
    })
end

local function SetStatus(text)
    if StatusLabel then
        StatusLabel:Set("Status: " .. text)
    end
end

local function GetPrompt(path)
    local obj = workspace

    for _,v in ipairs(path) do
        obj = obj:FindFirstChild(v)

        if not obj then
            return nil
        end
    end

    return obj
end

