-- // VISUAL
MoreTab:CreateSection("Visual & Performance")

-- // HIDE NAMES
MoreTab:CreateToggle({
    Name = "Hide All Names",
    CurrentValue = false,
    Flag = "HideNames",

    Callback = function(Value)

        if Value then
            for _,v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BillboardGui") then
                    HiddenNames[v] = v.Enabled
                    v.Enabled = false
                end
            end

            SetStatus("Names Hidden")

        else
            for gui,state in pairs(HiddenNames) do
                if gui and gui.Parent then
                    gui.Enabled = state
                end
            end

            SetStatus("Names Visible")
        end
    end,
})

-- // HIDE CHARACTER
MoreTab:CreateToggle({
    Name = "Hide Character",
    CurrentValue = false,
    Flag = "HideChar",

    Callback = function(Value)

        Character = LP.Character or LP.CharacterAdded:Wait()

        for _,part in ipairs(Character:GetDescendants()) do

            if part:IsA("BasePart") or part:IsA("Decal") then

                if OriginalTransparency[part] == nil then
                    OriginalTransparency[part] = part.Transparency
                end

                part.Transparency = Value and 1 or OriginalTransparency[part]
            end
        end

        SetStatus(Value and "Character Hidden" or "Character Visible")
    end,
})

-- // FPS BOOST
MoreTab:CreateButton({
    Name = "FPS Boost",

    Callback = function()

        for _,v in ipairs(workspace:GetDescendants()) do

            if v:IsA("BasePart") then
                v.Material = Enum.Material.SmoothPlastic
                v.Reflectance = 0

            elseif v:IsA("Decal")
                or v:IsA("Texture")
                or v:IsA("ParticleEmitter")
                or v:IsA("Trail") then

                v.Enabled = false
            end
        end

        game.Lighting.GlobalShadows = false
        game.Lighting.FogEnd = 100000

        SetStatus("FPS Boost Enabled")

        Notify(
            "Performance",
            "FPS Boost Applied"
        )
    end,
})

-- // BUS
MoreTab:CreateSection("Auto Buy Bus")

SelectedBusToBuy = SelectedBusToBuy or "None"

MoreTab:CreateDropdown({
    Name = "Select Bus",
    Options = CarListData,
    CurrentOption = {CarListData[1] or "None"},
    MultipleOptions = false,

    Callback = function(Option)
        SelectedBusToBuy = Option[1]
    end,
})

MoreTab:CreateButton({
    Name = "Buy Selected Bus",

    Callback = function()

        if not SelectedBusToBuy
            or SelectedBusToBuy == "None" then

            Notify(
                "Error",
                "Please select a bus first!"
            )

            return
        end

        local success,err = pcall(function()

            Remotes:WaitForChild("BuyCar")
                :FireServer(SelectedBusToBuy)

        end)

        if success then

            SetStatus("Purchased " .. SelectedBusToBuy)

            Notify(
                "Success",
                "Purchased: "..SelectedBusToBuy
            )

        else

            warn(err)

            Notify(
                "Error",
                "Purchase Failed"
            )
        end
    end,
})

-- // TELEPORT
MoreTab:CreateSection("World Teleport")

SelectedTP = "Dealership"

MoreTab:CreateDropdown({
